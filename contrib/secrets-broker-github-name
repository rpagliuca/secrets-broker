#!/bin/sh
# Usage: secrets-broker-github-name OWNER/REPO
# Prints the broker name of the highest level this client holds for the
# repository (SB_GITHUB_LEVELS, highest first), or nothing.
. "$(dirname "$0")/sb-common.sh"
set -eu
or=$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')
owner=${or%%/*}
repo=${or#*/}
repo=${repo%.git}
prefix=
for m in ${SB_GITHUB_OWNERS:-}; do
	[ "${m%%=*}" = "$owner" ] && prefix=${m#*=}
done
[ -n "$prefix" ] && [ -n "$SB_TOKEN" ] || exit 0
held=$(env "$SB_TOKEN_VAR=$SB_TOKEN" "$SB_BIN" access -token-env "$SB_TOKEN_VAR" 2>/dev/null) || exit 0
for level in $SB_GITHUB_LEVELS; do
	n="$prefix/$repo/$level"
	if printf '%s' "$held" | grep -q "\"credential\":\"$n\""; then
		echo "$n"
		exit 0
	fi
done
