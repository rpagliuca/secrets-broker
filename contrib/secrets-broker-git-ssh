#!/bin/sh
# git's SSH command (core.sshCommand or GIT_SSH_COMMAND). With a client token,
# git over SSH to the hosts of SB_GIT_SSH_TARGETS ("github.com=name ...") goes
# through the broker's SSH proxy, which holds the key; anything else is plain
# ssh. "--target NAME" first fixes the broker target for one clone:
#   git config core.sshCommand "secrets-broker-git-ssh --target org/git/ssh/one-repo"
. "$(dirname "$0")/sb-common.sh"
fixed=
if [ "${1:-}" = "--target" ]; then
	fixed=$2
	shift 2
fi
target=
for a in "$@"; do
	case "$a" in git@*)
		host=${a#git@}
		for m in ${SB_GIT_SSH_TARGETS:-}; do
			[ "${m%%=*}" = "$host" ] && target=${m#*=}
		done
		[ -n "$fixed" ] && target=$fixed
		;;
	esac
done
if [ -z "$SB_TOKEN" ] || [ -z "$target" ]; then
	exec ssh "$@"
fi
n=$#
while [ "$n" -gt 0 ]; do
	a=$1
	shift
	case "$a" in git@*) a="$target@127.0.0.1" ;; esac
	set -- "$@" "$a"
	n=$((n - 1))
done
SSH_ASKPASS="$(dirname "$0")/secrets-broker-askpass" SSH_ASKPASS_REQUIRE=force exec ssh -p "$SB_SSH_PORT" \
	-o UserKnownHostsFile="$SB_RUNTIME/ssh_known_hosts" -o StrictHostKeyChecking=yes \
	-o PreferredAuthentications=password -o PubkeyAuthentication=no \
	-o NumberOfPasswordPrompts=1 -o IdentityAgent=none "$@"
