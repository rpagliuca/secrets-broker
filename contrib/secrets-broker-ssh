#!/bin/sh
# SSH to a target of the broker: secrets-broker-ssh TARGET [ssh options] [command]
. "$(dirname "$0")/sb-common.sh"
target=${1:?usage: secrets-broker-ssh TARGET [ssh options] [command]}
shift
SSH_ASKPASS="$(dirname "$0")/secrets-broker-askpass" SSH_ASKPASS_REQUIRE=force exec ssh -p "$SB_SSH_PORT" \
	-o UserKnownHostsFile="$SB_RUNTIME/ssh_known_hosts" -o StrictHostKeyChecking=yes \
	-o PreferredAuthentications=password -o PubkeyAuthentication=no \
	-o NumberOfPasswordPrompts=1 -o IdentityAgent=none -l "$target" 127.0.0.1 "$@"
